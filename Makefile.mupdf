# Makefile.mupdf — build MuPDF natively for Nintendo Switch
# Delegates to MuPDF's own Makefile with cross-compilation overrides.

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

MUPDF_DIR := mupdf

# Cross-compiler
export CC      := aarch64-none-elf-gcc
export CXX     := aarch64-none-elf-g++
export AR      := aarch64-none-elf-ar
export RANLIB  := aarch64-none-elf-ranlib
export STRIP   := aarch64-none-elf-strip
export LD      := aarch64-none-elf-ld

# Switch-specific flags
ARCH     := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIC
SWITCH_INC := -I$(DEVKITPRO)/libnx/include

# MuPDF config: disable unsupported features for embedded use
export DEFINES := \
    -D__SWITCH__ \
    -DFZ_ENABLE_ICC=0 \
    -DFZ_ENABLE_JS=0 \
    -DHAVE_PTHREAD=0 \
    -DFZ_NO_STDIO=0 \
    -DOPJ_STATIC \
    -DNDEBUG

export CFLAGS   := $(ARCH) -O2 -ffunction-sections -Wno-error -std=gnu11 $(DEFINES) $(SWITCH_INC)
export CXXFLAGS := $(ARCH) -O2 -ffunction-sections -Wno-error -std=gnu++14 $(DEFINES) $(SWITCH_INC)
export LDFLAGS  := $(ARCH) -O2 -Wl,--gc-sections

.PHONY: all clean
all: lib/libmupdf.a

lib/libmupdf.a:
	@mkdir -p lib
	@echo "=== Building MuPDF (native cross-compile) ==="
	@cd $(MUPDF_DIR) && \
	  make -j$$(nproc) build=release \
	    HAVE_TESSERA=no HAVE_GLFW=no NOX11=yes NOGLCALLS=yes \
	    2>&1 | tail -20
	@echo "=== Copying MuPDF artifacts ==="
	@cp -v $(MUPDF_DIR)/build/release/libmupdf*.a lib/ 2>/dev/null || \
	  (echo "ERROR: MuPDF build failed - check output above" && exit 1)
	@find $(MUPDF_DIR)/build/release/thirdparty -name "*.a" -exec cp {} lib/ \; 2>/dev/null || true
	@echo "=== MuPDF build complete ==="

clean:
	@cd $(MUPDF_DIR) && make clean 2>/dev/null || true
	@rm -rf lib/*.a
