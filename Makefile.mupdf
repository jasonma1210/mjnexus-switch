# Makefile.mupdf — build MuPDF (embedded) for Nintendo Switch
# MuPDF 1.16.1, uses Switch portlibs for all thirdparty deps
# (zlib, freetype, libjpeg, libpng, bzip2, lz4, harfbuzz — no bundled thirdparty)

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

MUPDF_DIR := mupdf
PORTLIBS  := $(DEVKITPRO)/portlibs/switch

CC      := aarch64-none-elf-gcc
AR      := aarch64-none-elf-ar

ARCH     := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIC

DEFINES := \
    -DNDEBUG -DTOFU -DTOFU_CJK \
    -D__SWITCH__ \
    -DFZ_ENABLE_ICC=0 \
    -DFZ_ENABLE_JS=0 \
    -DFZ_HAVE_PTHREAD=0 \
    -DHAVE_PTHREAD=0 \
    -DFZ_NO_STDIO=0 \
    -DOPJ_STATIC -DOPJ_HAVE_STDINT_H -DOPJ_HAVE_INTTYPES_H \
    -D_POSIX_C_SOURCE=200809L \
    -Dtimegm=mjx_timegm

INCLUDES := \
    -I$(MUPDF_DIR)/include \
    -I$(MUPDF_DIR)/generated \
    -I$(DEVKITPRO)/libnx/include \
    -I$(PORTLIBS)/include \
    -I$(PORTLIBS)/include/freetype2 \
    -I$(PORTLIBS)/include/harfbuzz \
    -I$(CURDIR)/include

# -include mjx_stubs/timegm.h: 预加载 mjx_timegm 声明，因为 -Dtimegm=mjx_timegm 替换后
# MuPDF 源文件需要 mjx_timegm 函数，但它不在 MuPDF 库里（在主工程 stub 里）
CFLAGS   := $(ARCH) -O2 -Wno-error -std=gnu11 $(DEFINES) $(INCLUDES) -include mjx_stubs/timegm.h

FITZ_SRC := $(wildcard $(MUPDF_DIR)/source/fitz/*.c)
PDF_SRC  := $(wildcard $(MUPDF_DIR)/source/pdf/*.c)
XPS_SRC  := $(wildcard $(MUPDF_DIR)/source/xps/*.c)
CBZ_SRC  := $(wildcard $(MUPDF_DIR)/source/cbz/*.c)
FB2_SRC  := $(wildcard $(MUPDF_DIR)/source/fb2/*.c)
EPUB_SRC := $(wildcard $(MUPDF_DIR)/source/epub/*.c)
SVG_SRC  := $(wildcard $(MUPDF_DIR)/source/svg/*.c)

# 过滤掉需要不存在的 thirdparty 的源文件
FITZ_SRC := $(filter-out \
    %color-lcms.c %img-png.c %img-tiff.c %save-tiff.c %write-png.c \
    %filter-jbig2.c %filter-openjpeg.c %filter-lz4.c %filter-fax.c \
    %load-jbig2.c %load-jpx.c %load-png.c %load-tiff.c %save-png.c %save-tiff.c \
    %jmemcust.c \
    ,$(FITZ_SRC))

# 所有 thirdparty 都用 Switch portlibs
ALL_SRC := $(FITZ_SRC) $(PDF_SRC) $(XPS_SRC) $(CBZ_SRC) $(FB2_SRC) $(EPUB_SRC) $(SVG_SRC)

OBJ_DIR := mupdf-build
OBJ_FILES := $(patsubst $(MUPDF_DIR)/%.c,$(OBJ_DIR)/%.o,$(ALL_SRC))

.PHONY: all clean
all: lib/libmupdf.a

lib/libmupdf.a: $(OBJ_FILES)
	@mkdir -p lib
	@echo ">>> Archiving libmupdf.a ($(words $(OBJ_FILES)) objects)"
	@$(AR) rcs $@ $(OBJ_FILES)
	@echo ">>> Done: libmupdf.a"

$(OBJ_DIR)/%.o: $(MUPDF_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

clean:
	@rm -rf $(OBJ_DIR) lib/libmupdf.a
